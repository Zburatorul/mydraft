{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowJs": true, "skipLibCheck": true,
    "types": ["bun-types"], "allowImportingTsExtensions": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "web", "vendor"]
}
