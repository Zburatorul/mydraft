{
  "name": "mydraft",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Markdown viewer + annotation layer + agent CLI for human–agent knowledge work",
  "bin": {
    "myd": "./src/cli.ts"
  },
  "scripts": {
    "myd": "bun src/cli.ts",
    "test": "bun test",
    "test:e2e": "status=0; for f in ./src/*.e2e.ts; do bun test \"$f\" --timeout 30000 || status=1; done; exit $status",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-rehype": "^11.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "unist-util-visit": "^5.0.0",
    "@shikijs/rehype": "^4.4.3",
    "katex": "^0.16.0",
    "mermaid": "^11.16.1",
    "vega": "^6.0.0",
    "vega-lite": "^6.0.0",
    "vega-embed": "^7.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3"
  }
}
