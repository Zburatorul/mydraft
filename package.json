{
  "name": "mydraft",
  "version": "0.1.0",
  "description": "Review Markdown with your coding agent: rich rendering, comments on text, diagrams and charts, saved as CriticMarkup in the file",
  "license": "MIT",
  "author": "Eugeniu Plamadeala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zburatorul/mydraft.git"
  },
  "homepage": "https://github.com/Zburatorul/mydraft#readme",
  "bugs": "https://github.com/Zburatorul/mydraft/issues",
  "keywords": [
    "markdown",
    "review",
    "criticmarkup",
    "claude-code",
    "codex",
    "coding-agent",
    "mermaid",
    "annotation",
    "roughdraft"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "myd": "./bin/myd.js",
    "mydraft": "./bin/myd.js"
  },
  "files": [
    "bin/myd.js",
    "bin/rd-diff",
    "dist/",
    "web/",
    "!web/*.test.js",
    "vendor/",
    "skill/",
    "docs/prompt.md"
  ],
  "scripts": {
    "myd": "bun src/cli.ts",
    "test": "bun test",
    "test:e2e": "status=0; for f in ./src/*.e2e.ts; do bun test \"$f\" --timeout 30000 || status=1; done; exit $status",
    "typecheck": "npx tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "katex": "^0.16.0",
    "mermaid": "^11.16.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vega": "^6.0.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.0.0",
    "ws": "8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/ws": "^8.18.2",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3"
  }
}
